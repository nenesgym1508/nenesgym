# Supabase — obtener en dashboard.supabase.com > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# URL base de la app (sin trailing slash)
# En produccion DEBE ser el dominio propio (https://nenesgym.com), nunca una URL
# *.vercel.app: esas estan detras de la proteccion de despliegue de Vercel y
# redirigen a vercel.com/login, asi que los enlaces de invitacion que se mandan
# por WhatsApp no se podrian abrir. En desarrollo, el puerto del servidor (3005).
NEXT_PUBLIC_APP_URL=http://localhost:3005

# Sentry — opcional. Sin esto, el monitoreo de errores queda desactivado (no falla nada).
# Crear proyecto (plataforma "Next.js") en sentry.io > Settings > Projects > tu proyecto > Client Keys (DSN)
# El mismo DSN va en las dos variables.
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxx@xxxxxxx.ingest.us.sentry.io/xxxxxxx
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxx@xxxxxxx.ingest.us.sentry.io/xxxxxxx

# Cloudflare R2 — storage de imágenes/videos de ejercicios (compatible con S3).
# dash.cloudflare.com > R2 Object Storage > (bucket) > Settings, y > Manage API Tokens
R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_BUCKET_NAME=nenesgym-exercises
# Host publico del bucket. Hoy es la URL de desarrollo (pub-*.r2.dev), que Cloudflare
# limita y no cachea en el borde. Al conectar un dominio propio, poner aqui
# https://img.nenesgym.com y reescribir las media_url con
# scripts/switch-r2-public-url.mjs
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

# Nota: las imagenes de ejercicio NO pasan por el optimizador de Vercel. Al subir
# se generan variantes ya recortadas (-thumb, -detail) que se guardan en R2 y se
# sirven como archivos estaticos. No hace falta ninguna variable para eso: ver
# src/lib/images.ts y scripts/generate-image-variants.mjs
